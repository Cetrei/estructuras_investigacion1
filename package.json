{
  "name": "estructuras-investigacion1",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit",

    "clean:build": "rm -rf build",
    
    "build:diagrams": "bun run scripts/buildDiagrams.ts",
    "build:pdf": "bun run scripts/buildPDF.ts",
    "build:all": "bun run build:diagrams && bun run build:pdf",
    "install:latex": "bun run scripts/installLatex.ts",
    
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@mermaid-js/mermaid-cli": "^10.9.1",
    "@puppeteer/browsers": "^2.4.1",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.3",
    "typescript": "^7.0.2"
  }
}
