%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '15px'}}}%%
flowchart TB

    subgraph RAM["MEMORIA RAM"]
        direction TB
        T1["mapaPosiciones - arreglo en RAM"]

        subgraph ARR["Zona ordenada - busqueda binaria O log n"]
            direction LR
            E0["indice 0<br/>carne: 1001<br/>posicion: 0<br/>estado: activo"]
            E1["indice 1<br/>carne: 1002<br/>posicion: 1<br/>estado: activo"]
            E2["indice 2<br/>carne: 1004<br/>posicion: 3<br/>estado: inactivo"]
            E3["indice 3<br/>carne: 1007<br/>posicion: 2<br/>estado: activo"]
            E0 --- E1 --- E2 --- E3
        end

        subgraph REC["Lista de recien ingresados - sin ordenar"]
            direction LR
            N0["indice 0<br/>carne: 1015<br/>posicion: 4<br/>estado: activo"]
        end

        T1 --> ARR
        T1 --> REC
    end

    subgraph DISCO["DISCO - archivos binarios de registro fijo"]
        direction LR

        subgraph COL0["posicion 0"]
            direction TB
            I0["identidad.dat<br/>carne 1001<br/>nombre, apellidos<br/>fechaNac, sexo"]
            A0["academico.dat<br/>carrera, nivel<br/>creditos, promedio"]
            C0["contacto.dat<br/>correo, telefono<br/>direccion"]
            I0 --- A0 --- C0
        end

        subgraph COL1["posicion 1"]
            direction TB
            I1["identidad.dat<br/>carne 1002<br/>nombre, apellidos<br/>fechaNac, sexo"]
            A1["academico.dat<br/>carrera, nivel<br/>creditos, promedio"]
            C1["contacto.dat<br/>correo, telefono<br/>direccion"]
            I1 --- A1 --- C1
        end

        subgraph COL2["posicion 2"]
            direction TB
            I2["identidad.dat<br/>carne 1007<br/>nombre, apellidos<br/>fechaNac, sexo"]
            A2["academico.dat<br/>carrera, nivel<br/>creditos, promedio"]
            C2["contacto.dat<br/>correo, telefono<br/>direccion"]
            I2 --- A2 --- C2
        end

        subgraph COL3["posicion 3"]
            direction TB
            I3["identidad.dat<br/>carne 1004<br/>nombre, apellidos<br/>fechaNac, sexo"]
            A3["academico.dat<br/>carrera, nivel<br/>creditos, promedio"]
            C3["contacto.dat<br/>correo, telefono<br/>direccion"]
            I3 --- A3 --- C3
        end

        subgraph COL4["posicion 4"]
            direction TB
            I4["identidad.dat<br/>carne 1015<br/>nombre, apellidos<br/>fechaNac, sexo"]
            A4["academico.dat<br/>carrera, nivel<br/>creditos, promedio"]
            C4["contacto.dat<br/>correo, telefono<br/>direccion"]
            I4 --- A4 --- C4
        end
    end

    E0 -.->|offset = 0 * sizeof| I0
    E1 -.->|offset = 1 * sizeof| I1
    E2 -.->|offset = 3 * sizeof| I3
    E3 -.->|offset = 2 * sizeof| I2
    N0 -.->|offset = 4 * sizeof| I4

    classDef ram fill:#e8f0fe,stroke:#4472c4,stroke-width:1px,color:#1a1a1a;
    classDef disco fill:#fdf2e3,stroke:#c9822a,stroke-width:1px,color:#1a1a1a;
    classDef inactivo fill:#fbe4e4,stroke:#c0392b,stroke-width:1px,color:#1a1a1a;
    classDef nuevo fill:#eafaf1,stroke:#27ae60,stroke-width:1px,color:#1a1a1a;

    class E0,E1,E3 ram;
    class E2 inactivo;
    class N0 nuevo;
    class I0,I1,I2,I3,I4,A0,A1,A2,A3,A4,C0,C1,C2,C3,C4 disco;
