%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '15px'}}}%%
flowchart TB

    q["Buscar carne 1007"]

    subgraph ORD["Zona ordenada - busqueda binaria O(log n)"]
        direction LR
        o0["idx 0<br/>1001"]
        o1["idx 1<br/>1002"]
        o2["idx 2<br/>1004"]
        o3["idx 3<br/>1007"]
        o4["idx 4<br/>1009"]
        o0 --- o1 --- o2 --- o3 --- o4
    end

    p1["medio = idx 2 -> 1004 menor que 1007, buscar mitad derecha"]
    p2["medio = idx 3 -> 1007 = 1007, encontrado"]

    q --> p1 --> p2
    p1 -.-> o2
    p2 -.-> o3

    subgraph REC["Lista de recien ingresados - recorrido lineal O(n)"]
        direction LR
        n0["idx 0<br/>1015"]
        n1["idx 1<br/>1003"]
        n2["idx 2<br/>1020"]
        n0 --- n1 --- n2
    end

    nota["Si no aparece en la zona ordenada,<br/>se revisa aqui de principio a fin"]
    o4 -.-> nota
    nota -.-> n0

    classDef celda fill:#ffffff,stroke:#28253D,stroke-width:1px,color:#1a1a1a;
    classDef objetivo fill:#FF6D00,stroke:#28253D,stroke-width:2px,color:#ffffff;
    classDef descartado fill:#F1F1F4,stroke:#8a8a99,stroke-width:1px,color:#5a5a5a;
    classDef formula fill:#F9F9FB,stroke:#8fa8d9,stroke-width:1px,color:#1a1a1a;

    class o0,o1,o4 celda;
    class o2 descartado;
    class o3 objetivo;
    class n0,n1,n2 celda;
    class q,p1,p2,nota formula;
